␀␀precision highp float;
precision highp int;
#define ST_UNITY6_GLES2 1
int st_maxi(int a, int b) { return a > b ? a : b; }
int st_mini(int a, int b) { return a < b ? a : b; }
␀␀out of memory␀␀␀highp float st_roundEven(highp float x) {
    highp float f = floor(x);
    highp float d = x - f;
    return d < 0.5 ? f : (d > 0.5 ? f + 1.0 : (mod(f, 2.0) == 0.0 ? f : f + 1.0));
}
highp vec2 st_roundEven(highp vec2 x) { return vec2(st_roundEven(x.x), st_roundEven(x.y)); }
highp vec3 st_roundEven(highp vec3 x) { return vec3(st_roundEven(x.x), st_roundEven(x.y), st_roundEven(x.z)); }
highp vec4 st_roundEven(highp vec4 x) { return vec4(st_roundEven(x.x), st_roundEven(x.y), st_roundEven(x.z), st_roundEven(x.w)); }
